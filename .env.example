# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: a separate key for the companion chat feature (product Q&A, review
# summaries), so it doesn't compete with the root-cause agent for the same
# free-tier rate limit. Falls back to GROQ_API_KEY above if left unset.
# COMPANION_GROQ_API_KEY=gsk_your_second_key_here

# --- Optional overrides (defaults shown) ---

# Chosen by benchmark: the only tested Groq model that supports strict
# json_schema, so the response is guaranteed to match our contract.
# RCA_MODEL=openai/gpt-oss-120b
# RCA_FALLBACK_MODEL=openai/gpt-oss-20b

# gpt-oss are reasoning models — reasoning shares the token budget with the
# answer. A full analysis measures ~830 tokens; 2400 leaves ~3x headroom.
# Raising this reduces throughput: max_tokens is RESERVED against the free
# tier's 12k tokens/min ceiling.
# RCA_MAX_TOKENS=2400
# RCA_REASONING_EFFORT=low
# RCA_TEMPERATURE=0.2
# RCA_TIMEOUT_SECONDS=30

# Trigger policy. 0.80 matches the model's "high" risk tier, where holdout
# precision is 0.904.
# RCA_PROBABILITY_THRESHOLD=0.80
# RCA_MIN_CART_AGE_SECONDS=10
# RCA_COOLDOWN_SECONDS=90
# RCA_MAX_PER_SESSION=10
